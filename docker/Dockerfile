FROM ghcr.io/cyber-dojo-languages/kotlin:ad5c23a

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# START of extra commands to fulfil runner's requirements (os=Alpine)
# ensure getent is installed
RUN apk add musl-utils
RUN (getent group sandbox) || (addgroup -g 51966 sandbox) || (groupadd -g 51966 sandbox)
RUN (grep -q sandbox:x:41966 /etc/passwd) || (adduser -D -g "" -h /home/sandbox -G sandbox -s /bin/bash -u 41966 sandbox)
RUN apk add --update coreutils bash tar file
ARG GIT_COMMIT_SHA
ENV SHA=${GIT_COMMIT_SHA}
# END of extra commands to fulfil runner's requirements
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

LABEL maintainer=jon@jaggersoft.com

# maven resolves the jars named in pom.xml into /kotlin at build time. It and
# the JDK it pulls in leave with the virtual package, so neither reaches the
# final image.
COPY pom.xml .
RUN apk add --virtual=build-dependencies maven \
  && mvn --batch-mode --quiet dependency:copy-dependencies -DoutputDirectory=/kotlin \
  && apk del build-dependencies \
  && rm -rf pom.xml ~/.m2 /tmp/* /var/cache/apk/*

ENV CLASSPATH=/kotlin/

# Recorded here so that every run replays them instead of doing the same work
# again. The compiler gets an AOT cache and the test launcher a class-data
# archive; the script explains why they differ. Together they cost about 140MB
# of image and take a run from about 1.5s to about 0.8s.
COPY record_startup_archives.sh .
RUN sh record_startup_archives.sh \
  && rm record_startup_archives.sh
