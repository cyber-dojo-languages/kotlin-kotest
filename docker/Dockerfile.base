FROM ghcr.io/cyber-dojo-languages/kotlin:a6e870f
LABEL maintainer=jon@jaggersoft.com

# maven resolves the newest jars named in pom.xml into /kotlin at build time.
# It and the JDK it pulls in leave with the virtual package, so neither
# reaches the final image.
COPY pom.xml install_jars.sh ./
RUN apk add --virtual=build-dependencies maven \
  && sh install_jars.sh \
  && apk del build-dependencies \
  && rm -rf pom.xml install_jars.sh ~/.m2 /tmp/* /var/cache/apk/*

ENV CLASSPATH=/kotlin/

# Recorded here so that every run replays them instead of doing the same work
# again. The compiler and the test launcher each get an AOT cache; the script
# explains what is in them. Together they cost about 140MB of image and take a
# run from about 1.5s to about 0.8s.
COPY record_startup_archives.sh .
RUN sh record_startup_archives.sh \
  && rm record_startup_archives.sh
